@using Backtalk.Services
@inject NavigationManager nav
@inject INotificationService notificationService
@inject IJSRuntime js

@if (!projectNavmenu)
{
    <nav class="navmenu container-fluid theme-@(theme)">
        <div class="row">
            <div class="col-5 navmenu-navlinks-container">
                <a class="navmenu-navlink @homeNavlinkClass" href="" @onclick="() => HandleNavLinkClicked('h')">Home</a>
                <a class="navmenu-navlink @projectsNavlinkClass" href="projects" @onclick="() => HandleNavLinkClicked('p')">Projects</a>
                <a class="navmenu-navlink @aboutNavlinkClass" href="about" @onclick="() => HandleNavLinkClicked('a')">About</a>
            </div>
            <div class="col-2 navmenu-brand-container">
                <img src="@Assets["logo.png"]" alt="logo" class="navmenu-logo-image" @onclick="HandleLogoClicked" />
            </div>
            <div class="col-5 navmenu-account-options">
                <a class="navmenu-navlink-account" href="signup" @onclick="HandleAccountOptionsClicked" @onclick:preventDefault="true">Sign Up</a>
                <a class="navmenu-navlink-account" href="login" @onclick="HandleAccountOptionsClicked" @onclick:preventDefault="true">Log In</a>
            </div>
        </div>
    
    </nav>
} else
{
    <nav class="navmenu-dropdown">
        <img class="navmenu-dropdown-logo" src="@Assets["logo.png"]" alt="logo" data-clickable="true" @onclick="HandleDropDownLogoClicked" @onclick:preventDefault="true" @onclick:stopPropagation="true" />
        <div class="navmenu-dropdown-menu" style="@dropdownMenuStyle">
            <a class="navmenu-dropdown-navlink @homeNavlinkClass" id="navmenu-dropdown-navlink-home" href="" @onclick="() => HandleNavLinkClicked('h')">Home</a>
            <a class="navmenu-dropdown-navlink @projectsNavlinkClass" id="navmenu-dropdown-navlink-projects" href="projects" @onclick="() => HandleNavLinkClicked('p')">Projects</a>
            <a class="navmenu-dropdown-navlink @aboutNavlinkClass" id="navmenu-dropdown-navlink-about" href="about" @onclick="() => HandleNavLinkClicked('a')">About</a>
        </div>
    </nav>
}


@code {
    [CascadingParameter]
    public string theme { get; set; } = "light";

    private string navlinkActiveClass = "navmenu-navlink-active";
    private string homeNavlinkClass = "navmenu-navlink-active";
    private string projectsNavlinkClass = "";
    private string aboutNavlinkClass = "";

    private bool projectNavmenu = false;
    private bool projectNavmenuExpanded = false;
    private string dropdownMenuStyle = "border-style: none;";
    //this stops the click event listener from instantly closing the menu before it even opens
    private bool projectNavmenuDropdownClicking = false;

    private DotNetObjectReference<NavMenu>? _objRef = null;

    protected override async Task OnInitializedAsync()
    {
        UpdateNavMenu(null, null);
        nav.LocationChanged += UpdateNavMenu;
        _objRef = DotNetObjectReference.Create(this);
        await js.InvokeVoidAsync("ClickLibrary.apply", "CloseDropDownMenu", _objRef);
    }

    private async void UpdateNavMenu(object? sender, LocationChangedEventArgs? args)
    {
        if (nav.Uri == nav.BaseUri + string.Empty)
        {
            //home
            homeNavlinkClass = navlinkActiveClass;
            projectsNavlinkClass = "";
            aboutNavlinkClass = "";
            projectNavmenu = false;
        }
        else if (nav.Uri.Contains("project"))
        {
            //projects
            homeNavlinkClass = "";
            projectsNavlinkClass = navlinkActiveClass;
            aboutNavlinkClass = "";
            projectNavmenu = false;
            if (nav.Uri.Contains("project?key="))
            {
                //shrink navbar
                projectNavmenu = true;
            }
        }
        else if (nav.Uri.Contains("about"))
        {
            //about
            homeNavlinkClass = "";
            projectsNavlinkClass = "";
            aboutNavlinkClass = navlinkActiveClass;
            projectNavmenu = false;
        }
        else
        {
            //none
            homeNavlinkClass = "";
            projectsNavlinkClass = "";
            aboutNavlinkClass = "";
            projectNavmenu = false;
        }
        StateHasChanged();
        await Task.Yield();
    }

    private async Task HandleLogoClicked()
    {
        nav.NavigateTo("");
        homeNavlinkClass = navlinkActiveClass;
        projectsNavlinkClass = "";
        aboutNavlinkClass = "";
        StateHasChanged();
        await Task.Yield();
    }

    private async Task HandleNavLinkClicked(char linkPrefix)
    {
        switch (linkPrefix)
        {
            case 'h':
                homeNavlinkClass = navlinkActiveClass;
                projectsNavlinkClass = "";
                aboutNavlinkClass = "";
                break;
            case 'p':
                homeNavlinkClass = "";
                projectsNavlinkClass = navlinkActiveClass;
                aboutNavlinkClass = "";
                break;
            case 'a':
                homeNavlinkClass = "";
                projectsNavlinkClass = "";
                aboutNavlinkClass = navlinkActiveClass;
                break;
            default:
                homeNavlinkClass = navlinkActiveClass;
                projectsNavlinkClass = "";
                aboutNavlinkClass = "";
                break;
        }
        StateHasChanged();
        await Task.Yield();
    }

    private async Task HandleAccountOptionsClicked()
    {
        await notificationService.CreatePopupNotificationAsync(new Classes.Notification()
        {
            type = Classes.NotificationType.POPUP_ERROR,
            symbol = Classes.NotificationSymbol.WARNING,
            message = "Account options have not been implemented yet.",
            expire_at_utc = DateTime.UtcNow.AddSeconds(3)
        });
    }




    private async Task HandleDropDownLogoClicked()
    {
        projectNavmenuDropdownClicking = true;
        projectNavmenuExpanded = !projectNavmenuExpanded;
        if (projectNavmenuExpanded)
        {
            dropdownMenuStyle = "height: 80px; width: 100px; opacity: 1;";
        } else
        {
            dropdownMenuStyle = "border-style: none;";
        }
        StateHasChanged();
        await Task.Yield();
        projectNavmenuDropdownClicking = false;
    }

    [JSInvokable]
    public async Task CloseDropDownMenu()
    {
        if (!projectNavmenuDropdownClicking)
        {
            projectNavmenuExpanded = false;
            dropdownMenuStyle = "border-style: none;";
            Console.WriteLine("CloseDropDownMenu");
            StateHasChanged();
            await Task.Yield();
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_objRef != null)
        {
            try
            {
                await js.InvokeVoidAsync("ClickLibrary.cleanup", "CloseDropDownMenu", _objRef);
            }
            catch (Exception ex)
            {
                Console.WriteLine(ex);
            }
            finally
            {
                _objRef.Dispose();
            }
        }
    }

}
