    {
      "key": "bbbbbbbb-0001-4000-8000-000000000001",
      "name": "List Products",
      "endpoint": "https://api.shopstream.io/v2/products",
      "method": "GET",
      "tags": ["products", "catalog"],
      "query_parameters": [
        { "name": "page", "type": "integer", "example": "1", "required": false },
        { "name": "limit", "type": "integer", "example": "20", "required": false },
        { "name": "category", "type": "string", "example": "electronics", "required": false },
        { "name": "search", "type": "string", "example": "wireless headphones", "required": false },
        { "name": "sort", "type": "string", "example": "price_asc", "required": false }
      ],
      "headers": [
        { "name": "Content-Type", "value": "application/json" }
      ],
      "body": null,
      "responses": [
        {
          "status_code": 200,
          "condition": "Success",
          "message": "Returns paginated product list",
          "response": "{\n  \"data\": [\n    {\n      \"id\": \"prod-abc123\",\n      \"name\": \"Wireless Headphones Pro\",\n      \"price\": 89.99,\n      \"category\": \"electronics\",\n      \"stock\": 142\n    }\n  ],\n  \"page\": 1,\n  \"total\": 340\n}"
        }
      ],
      "created_at_utc": "2024-09-01T09:20:00Z",
      "last_updated_utc": "2025-03-15T08:45:00Z"
    },
