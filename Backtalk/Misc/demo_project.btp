          "status_code": 200,
          "condition": "Valid refresh token",
          "message": "Token refreshed",
          "response": "{\n  \"access_token\": \"eyJuZXci...\",\n  \"expires_in\": 3600\n}"
        },
        {
          "status_code": 401,
          "condition": "Expired or invalid refresh token",
          "message": "Unauthorized",
          "response": "{\n  \"error\": \"Refresh token is invalid or expired.\"\n}"
        }
      ],
