@using Backtalk.Classes

<div class="explorer-endpoint-item @methodClass" data-clickable="true" @onclick="HandleEndpointItemClicked" @onclick:preventDefault="true" @onclick:stopPropagation="true" @ondblclick="HandleEndpointItemDoubleClicked" @ondblclick:stopPropagation="true" @oncontextmenu="HandleEndpointItemRightClicked" @oncontextmenu:preventDefault="true" @oncontextmenu:stopPropagation="true">
    <img class="endpoint-item-icon" src="@Assets["icons/endpoint-black.png"]" alt="endpoint icon" />
    <p class="endpoint-item-name">@endpoint.name</p>
</div>

@code {
    [Parameter]
    public required ApiEndpoint endpoint { get; set; }

    [Parameter]
    public EventCallback<ApiEndpoint> endpointSelected { get; set; }
    [Parameter]
    public EventCallback<ApiEndpoint> endpointOpened { get; set; }
    [Parameter]
    public EventCallback<(ApiEndpoint endpoint, MouseEventArgs mea)> endpointContexed { get; set; }

    private string methodClass = "";
    private string contextMenuStyle = "display: none;";

    protected override async Task OnInitializedAsync()
    {
        switch (endpoint.method)
        {
            case "GET":
                methodClass = "endpoint-item-get";
                break;
            case "POST":
                methodClass = "endpoint-item-post";
                break;
            case "PUT":
                methodClass = "endpoint-item-put";
                break;
            case "PATCH":
                methodClass = "endpoint-item-patch";
                break;
            case "DELETE":
                methodClass = "endpoint-item-delete";
                break;
            default:
                methodClass = "endpoint-item-uhh";
                break;
        }
    }

    private async Task HandleEndpointItemClicked(MouseEventArgs args)
    {
        Console.WriteLine("Clicked! Button: " + args.Button);
    }

    private async Task HandleEndpointItemDoubleClicked()
    {

    }

    private async Task HandleEndpointItemRightClicked(MouseEventArgs mea)
    {
        Console.WriteLine("Context Menu! Button: " + mea.Button);
        await endpointContexed.InvokeAsync((endpoint, mea));
    }
}
