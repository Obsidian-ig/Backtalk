@inject IJSRuntime js

<div class="explorer-folder-item">
    <div class="explorer-folder-header-container">
        <button type="button" class="expand-collapse-button" @onclick="HandleExpandCollapseToggle" @onclick:stopPropagation="true">
            <img class="collapse-expand-arrow-icon @(folderExpanded ? "expanded" : "")" src="@Assets["icons/collapse-expand-arrow-black.png"]" alt="collapse expand arrow" />
        </button>
        <div class="folder-container @(focused ? "focused" : "")" data-clickable="true" @onclick="HandleFolderSelected" @onclick:stopPropagation="true" @ondblclick="HandleFolderOpened" @ondblclick:stopPropagation="true" @oncontextmenu="HandleFolderContexed" @oncontextmenu:stopPropagation="true" @oncontextmenu:preventDefault="true">
            <img class="folder-icon" src="@Assets["icons/folder-black.png"]" alt="folder" />
            @if (!folder.changingName)
            {
                <p class="folder-name">@folder.name</p>
            } else
            {
                <input @ref="renameInput" type="text" @bind="newName" @bind:after="HandleFinishChangingName" @onblur="HandleInputBlurred" data-clickable="true" />
            }
            
        </div>
    </div>
    <div class="folder-endpoints-container @(folderExpanded ? "endpoints-expanded" : "")">
        @if (folderExpanded && folder.endpoints_display_option != ExplorerDisplayOption.HIDDEN)
        {
            if (folder.endpoints_display_option == null)
            {
                foreach (var e in endpoints)
                {
                    var key = $"folder_endpoint-{e.key}";
                    <ExplorerEndpointItem @key="key"  endpoint="e" endpointSelected="HandleEndpointSelected" endpointOpened="HandleEndpointOpened" endpointContexed="HandleEndpointContexed" />
                }
            } else
            {
                var sortedList = endpoints;
                switch(folder.endpoints_display_option)
                {
                    case ExplorerDisplayOption.SORT_BY_NAME:
                        sortedList = Sorting.SortEndpointsByName(sortedList);
                        break;
                    case ExplorerDisplayOption.SORT_BY_NAME_REVERSED:
                        sortedList = Sorting.SortEndpointsByName(sortedList, reversed: true);
                        break;
                    case ExplorerDisplayOption.SORT_BY_TYPE:
                        sortedList = Sorting.SortEndpointsByType(sortedList);
                        break;
                    case ExplorerDisplayOption.SORT_BY_TYPE_REVERSED:
                        sortedList = Sorting.SortEndpointsByType(sortedList, reversed: true);
                        break;
                    case ExplorerDisplayOption.SORT_BY_CREATION_DATE:
                        sortedList = Sorting.SortEndpointsByCreationDate(sortedList);
                        break;
                    case ExplorerDisplayOption.SORT_BY_CREATION_DATE_REVERSED:
                        sortedList = Sorting.SortEndpointsByCreationDate(sortedList, reversed: true);
                        break;
                    case ExplorerDisplayOption.SORT_BY_LAST_MODIFIED:
                        sortedList = Sorting.SortEndpointsByLastModifiedDate(sortedList);
                        break;
                    case ExplorerDisplayOption.SORT_BY_LAST_MODIFIED_REVERSED:
                        sortedList = Sorting.SortEndpointsByLastModifiedDate(sortedList, reversed: true);
                        break;
                }
                foreach (var e in sortedList)
                {
                    var key = $"folder_endpoint-{e.key}";
                    <ExplorerEndpointItem @key="key" endpoint="e" endpointSelected="HandleEndpointSelected" endpointOpened="HandleEndpointOpened" endpointContexed="HandleEndpointContexed" />
                }
            }
        }
    </div>
</div>

@code {
    [Parameter]
    public required ProjectFolder folder { get; set; }
    [Parameter]
    public required List<ApiEndpoint> projectEndpoints { get; set; }

    [Parameter]
    public bool focused { get; set; } = false;

    [Parameter]
    public EventCallback<ProjectFolder> folderSelected { get; set; }
    [Parameter] //Will make the endpoints explorer open a view showing only the contents of the folder.
    public EventCallback<ProjectFolder> folderOpened { get; set; }
    [Parameter]
    public EventCallback<(ProjectFolder folder, MouseEventArgs mea)> folderContexed { get; set; }
    [Parameter]
    public EventCallback<(ProjectFolder changedFolder, string newName)> folderRenamed { get; set; }

    [Parameter]
    public EventCallback<ApiEndpoint> endpointSelected { get; set; }
    [Parameter]
    public EventCallback<ApiEndpoint> endpointOpened { get; set; }
    [Parameter]
    public EventCallback<(ApiEndpoint endpoint, MouseEventArgs mea)> endpointContexed { get; set; }

    private bool folderExpanded = false;
    private List<ApiEndpoint> endpoints = new();

    private string newName = "";

    private ElementReference renameInput;

    private DotNetObjectReference<ExplorerFolderItem>? _objRef = null;

    protected override async Task OnInitializedAsync()
    {
        foreach (var key in folder.endpoints)
        {
            foreach (var pe in projectEndpoints)
            {
                if (pe.key == key)
                {
                    endpoints.Add(pe);
                }
            }
        }

        newName = folder.name;

        _objRef = DotNetObjectReference.Create(this);
        await js.InvokeVoidAsync("ClickLibrary.apply", "UnfocusNameInput", _objRef);

    }

    

    protected override async Task OnParametersSetAsync()
    {
        StateHasChanged();
        await Task.Yield();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (folder.changingName)
        {
            if (renameInput.Context != null)
            {
                await renameInput.FocusAsync();
                Console.WriteLine("Focused the rename input");
            }
        }
    }



    private async Task HandleExpandCollapseToggle()
    {
        folderExpanded = !folderExpanded;
        StateHasChanged();
        await Task.Yield();
    }


    private async Task HandleFolderSelected()
    {
        await folderSelected.InvokeAsync(folder);
        //styling and stuff idk
    }
    private async Task HandleFolderOpened()
    {
        await folderOpened.InvokeAsync(folder);
    }
    private async Task HandleFolderContexed(MouseEventArgs mea)
    {
        await folderContexed.InvokeAsync((folder, mea));
    }


    //Pipelines from the child api endpoints to the endpoints explorer
    private async Task HandleEndpointSelected(ApiEndpoint endpoint)
    {
        await endpointSelected.InvokeAsync(endpoint);
    }

    private async Task HandleEndpointOpened(ApiEndpoint endpoint)
    {
        await endpointOpened.InvokeAsync(endpoint);
    }

    private async Task HandleEndpointContexed((ApiEndpoint endpoint, MouseEventArgs mea) p)
    {
        await endpointContexed.InvokeAsync(p);
    }


    private async Task HandleInputBlurred()
    {
        folder.changingName = false;
        StateHasChanged();
        await Task.Yield();
    }
    private async Task HandleFinishChangingName()
    {
        folder.changingName = false;
        await folderRenamed.InvokeAsync((folder, newName));
    }


    [JSInvokable]
    public async void UnfocusNameInput()
    {
        await HandleInputBlurred();
    }

    public async ValueTask DisposeAsync()
    {
        if (_objRef != null)
        {
            try
            {
                await js.InvokeVoidAsync("ClickLibrary.cleanup", "UnfocusNameInput", _objRef);
            }
            catch (Exception ex)
            {
                Console.WriteLine(ex);
            }
            finally
            {
                _objRef.Dispose();
            }
        }
    }
}
