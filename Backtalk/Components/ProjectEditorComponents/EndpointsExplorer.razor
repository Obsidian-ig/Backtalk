@inject IJSRuntime js

<div class="project-endpoints-explorer @explorerClass" id="project-endpoints-explorer" @onclick='HandleExplorerClicked'>
    <div class="explorer-header-container">
        <p class="header-text">Endpoints Explorer</p>
        <button type="button" class="close-window-button">X</button>
    </div>
    <div class="explorer-container" id="endpoints-explorer-folders-container">
        <div class="explorer-container-header-container">
            <p class="explorer-container-header">Folders</p>
            <button type="button" class="explorer-container-kebab-button">...</button>
        </div>
        @if (foldersDisplayOption != ExplorerDisplayOption.HIDDEN)
        {
            if (foldersDisplayOption == null)
            {
                foreach (var folder in project.folders)
                {
                    // explorer folder item here
                    <ExplorerFolderItem @key="folder" folder="folder" projectEndpoints="project.api_endpoints" endpointSelected="HandleEndpointSelected" endpointOpened="HandleEndpointOpened" endpointContexed="HandleEndpointRightClicked" folderSelected="HandleFolderSelected" folderOpened="HandleFolderOpened" folderContexed="HandleFolderRightClicked" folderRenamed="HandleFolderNameChanged" />
                }
            }
            else
            {
                var sortedList = project.folders;
                var option = foldersDisplayOption;
                switch (option)
                {
                    case ExplorerDisplayOption.SORT_BY_NAME:
                        sortedList = Sorting.SortFoldersByName(sortedList);
                        break;
                    case ExplorerDisplayOption.SORT_BY_NAME_REVERSED:
                        sortedList = Sorting.SortFoldersByName(sortedList, reversed: true);
                        break;
                    case ExplorerDisplayOption.SORT_BY_CREATION_DATE:
                        sortedList = Sorting.SortFoldersByCreationDate(sortedList);
                        break;
                    case ExplorerDisplayOption.SORT_BY_CREATION_DATE_REVERSED:
                        sortedList = Sorting.SortFoldersByCreationDate(sortedList, reversed: true);
                        break;
                    case ExplorerDisplayOption.SORT_BY_LAST_MODIFIED:
                        sortedList = Sorting.SortFoldersByLastModifiedDate(sortedList);
                        break;
                    case ExplorerDisplayOption.SORT_BY_LAST_MODIFIED_REVERSED:
                        sortedList = Sorting.SortFoldersByLastModifiedDate(sortedList, reversed: true);
                        break;
                    case ExplorerDisplayOption.SORT_BY_ENDPOINTS_COUNT:
                        sortedList = Sorting.SortFoldersByEndpointCount(sortedList);
                        break;
                    case ExplorerDisplayOption.SORT_BY_ENDPOINTS_COUNT_REVERSED:
                        sortedList = Sorting.SortFoldersByEndpointCount(sortedList, reversed: true);
                        break;
                }
                for (int j = 0; j < sortedList.Count; j++)
                {
                    // explorer folder item goes here
                    <ExplorerFolderItem @key="sortedList[j]" folder="sortedList[j]" projectEndpoints="project.api_endpoints" endpointSelected="HandleEndpointSelected" endpointOpened="HandleEndpointOpened" endpointContexed="HandleEndpointRightClicked" folderSelected="HandleFolderSelected" folderOpened="HandleFolderOpened" folderContexed="HandleFolderRightClicked" folderRenamed="HandleFolderNameChanged" />
                }
            }
        }
    </div>
    <div class="explorer-container" id="endpoints-explorer-all-container">
        <div class="explorer-container-header-container">
            <p class="explorer-container-header">All Endpoints</p>
            <button type="button" class="explorer-container-kebab-button">...</button>
        </div>
        @if (allDisplayOption != ExplorerDisplayOption.HIDDEN)
        {
            if (allDisplayOption == null && project.api_endpoints.Count > 0)
            {
                foreach (var endpoint in project.api_endpoints)
                {
                    <ExplorerEndpointItem @key="endpoint.key" endpoint="endpoint" endpointOpened="HandleEndpointOpened" endpointSelected="HandleEndpointSelected" endpointContexed="HandleEndpointRightClicked" />
                }
            }
            else
            {
                var sortedList = project.api_endpoints;
                var option = allDisplayOption;
                switch (option)
                {
                    case ExplorerDisplayOption.SORT_BY_NAME:
                        sortedList = Sorting.SortEndpointsByName(sortedList);
                        break;
                    case ExplorerDisplayOption.SORT_BY_NAME_REVERSED:
                        sortedList = Sorting.SortEndpointsByName(sortedList, reversed: true);
                        break;
                    case ExplorerDisplayOption.SORT_BY_TYPE:
                        sortedList = Sorting.SortEndpointsByType(sortedList);
                        break;
                    case ExplorerDisplayOption.SORT_BY_TYPE_REVERSED:
                        sortedList = Sorting.SortEndpointsByType(sortedList, reversed: true);
                        break;
                    case ExplorerDisplayOption.SORT_BY_CREATION_DATE:
                        sortedList = Sorting.SortEndpointsByCreationDate(sortedList);
                        break;
                    case ExplorerDisplayOption.SORT_BY_CREATION_DATE_REVERSED:
                        sortedList = Sorting.SortEndpointsByCreationDate(sortedList, reversed: true);
                        break;
                    case ExplorerDisplayOption.SORT_BY_LAST_MODIFIED:
                        sortedList = Sorting.SortEndpointsByLastModifiedDate(sortedList);
                        break;
                    case ExplorerDisplayOption.SORT_BY_LAST_MODIFIED_REVERSED:
                        sortedList = Sorting.SortEndpointsByLastModifiedDate(sortedList, reversed: true);
                        break;
                }
                if (sortedList.Count > 0)
                {
                    for (int j = 0; j < sortedList.Count; j++)
                    {
                        <ExplorerEndpointItem @key="sortedList[j].key" endpoint="sortedList[j]" endpointSelected="HandleEndpointSelected" endpointOpened="HandleEndpointOpened" endpointContexed="HandleEndpointRightClicked" />
                    }
                }
            }
        }
    </div>
</div>
<div class="endpoint-item-context-menu" style="@endpointContextMenuStyle">
    <button type="button" class="endpoint-item-context-menu-button" id="endpoint-item-context-menu-edit-button" @onclick="HandleEditContexedEndpoint" @onclick:stopPropagation="true">Edit</button>
    <button type="button" class="endpoint-item-context-menu-button" id="endpoint-item-context-menu-delete-button" @onclick="HandleDeleteContexedEndpoint" @onclick:stopPropagation="true">Delete</button>
</div>


<div class="folder-item-context-menu" style="@folderContextMenuStyle">
    <button type="button" class="folder-item-context-menu-button context-menu-start-button" id="folder-item-context-menu-button-open" @onclick="HandleContexedFolderOpened" @onclick:stopPropagation="true">Open</button>
    <button type="button" class="folder-item-context-menu-button" id="folder-item-context-menu-button-delete" @onclick="HandleContexedFolderDeleted" @onclick:stopPropagation="true">Delete</button>
    <button type="button" class="folder-item-context-menu-button" id="folder-item-context-menu-button-rename" @onclick="HandleContexedFolderRenamed" @onclick:stopPropagation="true">Rename</button>
    <button type="button" class="folder-item-context-menu-button @folderContextMenuSortingOptionButtonClass" id="folder-item-context-menu-button-sorting" @onclick="HandleFolderContextMenuSortingOptionsToggled" @onclick:stopPropagation="true" @onclick:preventDefault="true">
        Sorting
        <img class="folder-item-context-menu-sorting-button-icon @folderContextMenuSortingOptionButtonClass" src="@Assets["icons/collapse-expand-arrow-black.png"]" alt="collapse/expand icon" />
    </button>
    <div class="folder-item-context-menu-sorting-options-container @folderContextMenuSortingOptionsClass">
        <p class="sorting-options-container-header">Sort By:</p>
        <button type="button" class="folder-item-context-menu-sorting-option" id="folder-item-context-menu-sorting-option-name" @onclick="() => ChangeContexedFolderSortingOption(ExplorerDisplayOption.SORT_BY_NAME)" @onclick:stopPropagation="true">Name</button>
        <button type="button" class="folder-item-context-menu-sorting-option" id="folder-item-context-menu-sorting-option-namereversed" @onclick="() => ChangeContexedFolderSortingOption(ExplorerDisplayOption.SORT_BY_NAME_REVERSED)" @onclick:stopPropagation="true">Name (D)</button>
        <button type="button" class="folder-item-context-menu-sorting-option" id="folder-item-context-menu-sorting-option-type" @onclick="() => ChangeContexedFolderSortingOption(ExplorerDisplayOption.SORT_BY_TYPE)" @onclick:stopPropagation="true">Type</button>
        <button type="button" class="folder-item-context-menu-sorting-option" id="folder-item-context-menu-sorting-option-typereversed" @onclick="() => ChangeContexedFolderSortingOption(ExplorerDisplayOption.SORT_BY_TYPE_REVERSED)" @onclick:stopPropagation="true">Type (D)</button>
        <button type="button" class="folder-item-context-menu-sorting-option" id="folder-item-context-menu-sorting-option-creationdate" @onclick="() => ChangeContexedFolderSortingOption(ExplorerDisplayOption.SORT_BY_CREATION_DATE)" @onclick:stopPropagation="true">Creation Date</button>
        <button type="button" class="folder-item-context-menu-sorting-option" id="folder-item-context-menu-sorting-option-creationdatereversed" @onclick="() => ChangeContexedFolderSortingOption(ExplorerDisplayOption.SORT_BY_CREATION_DATE_REVERSED)" @onclick:stopPropagation="true">Creation Date (D)</button>
        <button type="button" class="folder-item-context-menu-sorting-option" id="folder-item-context-menu-sorting-option-lastmodified" @onclick="() => ChangeContexedFolderSortingOption(ExplorerDisplayOption.SORT_BY_LAST_MODIFIED)" @onclick:stopPropagation="true">Last Modified</button>
        <button type="button" class="folder-item-context-menu-sorting-option" id="folder-item-context-menu-sorting-option-lastmodifiedreversed" @onclick="() => ChangeContexedFolderSortingOption(ExplorerDisplayOption.SORT_BY_LAST_MODIFIED_REVERSED)" @onclick:stopPropagation="true">Last Modified (D)</button>
    </div>
</div>

@code {
    [Parameter]
    public required ProjectData project { get; set; }

    [Parameter]
    public bool focused { get; set; } = false;

    [Parameter]
    public EventCallback endpointsExplorerClicked { get; set; }
    [Parameter]
    public EventCallback<ApiEndpoint> endpointFocused { get; set; }
    [Parameter]
    public EventCallback<ApiEndpoint> endpointOpened { get; set; }
    [Parameter]
    public EventCallback<ApiEndpoint> endpointDeleted { get; set; }
    [Parameter]
    public EventCallback endpointCreated { get; set; }

    [Parameter]
    public EventCallback<ProjectFolder> folderFocused { get; set; }
    [Parameter]
    public EventCallback<ProjectFolder> folderDeleted { get; set; }
    [Parameter]
    public EventCallback<ProjectFolder> folderCreated { get; set; }
    [Parameter]
    public EventCallback<(ProjectFolder changedFolder, string newName)> folderRenamed { get; set; }


    private string explorerClass = "";
    private ApiEndpoint? focusedEndpoint = null; //the endpoint that should be displayed in the editor/props
    private ApiEndpoint? contexedEndpoint = null; //the endpoint the context menu is opened for
    private string endpointContextMenuStyle = "display: none;";

    private ProjectFolder? focusedFolder = null;
    private ProjectFolder? contexedFolder = null;
    private string folderContextMenuStyle = "display: none;"; //drop animation?
    private bool showFolderContextMenuSortingOptions = false;
    private string folderContextMenuSortingOptionsClass = "";
    private string folderContextMenuSortingOptionButtonClass = "";

    private string expandedClass = "expanded";
    private bool clickingContextMenuButtonThatShouldntCloseTheContextMenuAfterClickingLikeTheOtherButtons = false;

    private DotNetObjectReference<EndpointsExplorer>? _objRef;

    private ExplorerDisplayOption? foldersDisplayOption = null;
    private ExplorerDisplayOption? allDisplayOption = null;

    protected override async Task OnInitializedAsync()
    {
        Console.WriteLine("Initialized!");
        _objRef = DotNetObjectReference.Create(this);
        await js.InvokeVoidAsync("ClickLibrary.apply", "KillContextMenu", _objRef);
        foreach (var e in project.api_endpoints)
        {
            Console.WriteLine($"ENDPOINT: {e.name}, {e.key}, {e.endpoint}");
        }
    }


    protected override async Task OnParametersSetAsync()
    {
        StateHasChanged();
        await Task.Yield();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await js.InvokeVoidAsync("gsapInterop.makeDraggable", "#project-endpoints-explorer");
        }
    }

    private async Task HandleExplorerClicked()
    {
        await endpointsExplorerClicked.InvokeAsync();
    }

    private async Task HandleEndpointSelected(ApiEndpoint endpoint)
    {
        focusedEndpoint = endpoint;
        await endpointFocused.InvokeAsync(endpoint);
    }
    private async Task HandleEndpointOpened(ApiEndpoint endpoint)
    {
        await endpointOpened.InvokeAsync(endpoint);
    }
    private async Task HandleEndpointRightClicked((ApiEndpoint endpoint, MouseEventArgs mea) p)
    {
        contexedEndpoint = p.endpoint;
        endpointContextMenuStyle = $"display: flex; left: {p.mea.ClientX}px; top: {p.mea.ClientY}px;";
    }
    private async Task HandleEditContexedEndpoint()
    {
        await endpointOpened.InvokeAsync(contexedEndpoint);
    }
    private async Task HandleDeleteContexedEndpoint()
    {
        await endpointDeleted.InvokeAsync(contexedEndpoint);
    }






    private async Task HandleFolderSelected(ProjectFolder folder)
    {

    }
    private async Task HandleFolderOpened(ProjectFolder folder)
    {

    }
    private async Task HandleFolderRightClicked((ProjectFolder folder, MouseEventArgs mea) p)
    {
        contexedFolder = p.folder;
        folderContextMenuStyle = $"display: flex; left: {p.mea.ClientX}px; top: {p.mea.ClientY}px;";
        showFolderContextMenuSortingOptions = false;
        folderContextMenuSortingOptionsClass = "";
        folderContextMenuSortingOptionButtonClass = "";
    }



    private async Task HandleContexedFolderOpened()
    {

    }
    private async Task HandleContexedFolderDeleted()
    {

    }
    private async Task HandleContexedFolderRenamed()
    {
        if (contexedFolder == null) return;
        contexedFolder.changingName = true;
        StateHasChanged();
        await Task.Yield();
    }
    private async Task HandleFolderNameChanged((ProjectFolder changedFolder, string newName) p)
    {
        await folderRenamed.InvokeAsync(p);
    }
    private async Task HandleFolderContextMenuSortingOptionsToggled()
    {
        clickingContextMenuButtonThatShouldntCloseTheContextMenuAfterClickingLikeTheOtherButtons = true;
        showFolderContextMenuSortingOptions = !showFolderContextMenuSortingOptions;
        if (showFolderContextMenuSortingOptions)
        {
            folderContextMenuSortingOptionsClass = expandedClass;
            folderContextMenuSortingOptionButtonClass = expandedClass;
        } else
        {
            folderContextMenuSortingOptionsClass = "";
            folderContextMenuSortingOptionButtonClass = "";
        }
        StateHasChanged();
        await Task.Yield();
        clickingContextMenuButtonThatShouldntCloseTheContextMenuAfterClickingLikeTheOtherButtons = false;
    }
    private async Task ChangeContexedFolderSortingOption(ExplorerDisplayOption option)
    {
        if (contexedFolder == null) return;
        contexedFolder.endpoints_display_option = option;
        StateHasChanged();
        await Task.Yield();
    }






    [JSInvokable]
    public void KillContextMenu()
    {
        if (!clickingContextMenuButtonThatShouldntCloseTheContextMenuAfterClickingLikeTheOtherButtons)
        {
            contexedEndpoint = null;
            endpointContextMenuStyle = "display: none;";

            folderContextMenuStyle = "display: none;";
            showFolderContextMenuSortingOptions = false;
            folderContextMenuSortingOptionsClass = "";
            folderContextMenuSortingOptionButtonClass = "";
            Console.WriteLine("KillContextMenu");
            StateHasChanged();
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_objRef != null)
        {
            try
            {
                await js.InvokeVoidAsync("ClickLibrary.cleanup", "KillContextMenu", _objRef);
            } catch (Exception ex)
            {
                Console.WriteLine(ex);
            } finally
            {
                _objRef.Dispose();
            }
        }
    }
}
