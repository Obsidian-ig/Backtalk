@inject IJSRuntime js

<div class="project-endpoints-explorer @endpointsClass" id="project-endpoints-explorer" @onclick='HandleExplorerClicked'>
    <div class="explorer-header-container">
        <p class="header-text">Endpoints Explorer</p>
        <button type="button" class="close-window-button">X</button>
    </div>
    <div class="explorer-container" id="endpoints-explorer-folders-container">
        <div class="explorer-container-header-container">
            <p class="explorer-container-header">Folders</p>
            <button type="button" class="explorer-container-kebab-button">...</button>
        </div>
        @if (foldersDisplayOption != ExplorerDisplayOption.HIDDEN)
        {
            if (foldersDisplayOption == null)
            {
                foreach (var folder in project.folders)
                {
                    // explorer folder item here
                    <ExplorerFolderItem @key="folder" folder="folder" projectEndpoints="project.api_endpoints" />
                }
            }
            else
            {
                var sortedList = project.folders;
                var option = foldersDisplayOption;
                switch (option)
                {
                    case ExplorerDisplayOption.SORT_BY_NAME:
                        sortedList = SortFoldersByName(sortedList);
                        break;
                    case ExplorerDisplayOption.SORT_BY_NAME_REVERSED:
                        sortedList = SortFoldersByName(sortedList, reversed: true);
                        break;
                    case ExplorerDisplayOption.SORT_BY_CREATION_DATE:
                        sortedList = SortFoldersByCreationDate(sortedList);
                        break;
                    case ExplorerDisplayOption.SORT_BY_CREATION_DATE_REVERSED:
                        sortedList = SortFoldersByCreationDate(sortedList, reversed: true);
                        break;
                    case ExplorerDisplayOption.SORT_BY_LAST_MODIFIED:
                        sortedList = SortFoldersByLastModifiedDate(sortedList);
                        break;
                    case ExplorerDisplayOption.SORT_BY_LAST_MODIFIED_REVERSED:
                        sortedList = SortFoldersByLastModifiedDate(sortedList, reversed: true);
                        break;
                    case ExplorerDisplayOption.SORT_BY_ENDPOINTS_COUNT:
                        sortedList = SortFoldersByEndpointCount(sortedList);
                        break;
                    case ExplorerDisplayOption.SORT_BY_ENDPOINTS_COUNT_REVERSED:
                        sortedList = SortFoldersByEndpointCount(sortedList, reversed: true);
                        break;
                }
                for (int j = 0; j < sortedList.Count; j++)
                {
                    // explorer folder item goes here
                }
            }
        }
    </div>
    <div class="explorer-container" id="endpoints-explorer-all-container">
        <div class="explorer-container-header-container">
            <p class="explorer-container-header">All Endpoints</p>
            <button type="button" class="explorer-container-kebab-button">...</button>
        </div>
        @if (allDisplayOption != ExplorerDisplayOption.HIDDEN)
        {
            if (allDisplayOption == null)
            {
                foreach (var endpoint in project.api_endpoints)
                {
                    <ExplorerEndpointItem @key="endpoint.key" endpoint="endpoint" endpointOpened="HandleEndpointOpened" endpointSelected="HandleEndpointSelected" endpointContexed="HandleEndpointRightClicked" />
                }
            }
            else
            {
                var sortedList = project.api_endpoints;
                var option = allDisplayOption;
                switch (option)
                {
                    case ExplorerDisplayOption.SORT_BY_NAME:
                        sortedList = SortEndpointsByName(sortedList);
                        break;
                    case ExplorerDisplayOption.SORT_BY_NAME_REVERSED:
                        sortedList = SortEndpointsByName(sortedList, reversed: true);
                        break;
                    case ExplorerDisplayOption.SORT_BY_TYPE:
                        sortedList = SortEndpointsByType(sortedList);
                        break;
                    case ExplorerDisplayOption.SORT_BY_TYPE_REVERSED:
                        sortedList = SortEndpointsByType(sortedList, reversed: true);
                        break;
                    case ExplorerDisplayOption.SORT_BY_CREATION_DATE:
                        sortedList = SortEndpointsByCreationDate(sortedList);
                        break;
                    case ExplorerDisplayOption.SORT_BY_CREATION_DATE_REVERSED:
                        sortedList = SortEndpointsByCreationDate(sortedList, reversed: true);
                        break;
                    case ExplorerDisplayOption.SORT_BY_LAST_MODIFIED:
                        sortedList = SortEndpointsByLastModifiedDate(sortedList);
                        break;
                    case ExplorerDisplayOption.SORT_BY_LAST_MODIFIED_REVERSED:
                        sortedList = SortEndpointsByLastModifiedDate(sortedList, reversed: true);
                        break;
                }
                for (int j = 0; j < sortedList.Count; j++)
                {
                    <ExplorerEndpointItem @key="sortedList[j].key" endpoint="sortedList[j]" endpointSelected="HandleEndpointSelected" endpointOpened="HandleEndpointOpened" endpointContexed="HandleEndpointRightClicked" />
                }
            }
        }
    </div>
</div>
<div class="endpoint-item-context-menu" style="@contextMenuStyle">
    <button type="button" class="endpoint-item-context-menu-button" id="endpoint-item-context-menu-edit-button" @onclick="HandleEditContexed" @onclick:stopPropagation="true">Edit</button>
    <button type="button" class="endpoint-item-context-menu-button" id="endpoint-item-context-menu-delete-button" @onclick="HandleDeleteContexed" @onclick:stopPropagation="true">Delete</button>
</div>

@code {
    [Parameter]
    public required ProjectData project { get; set; }

    [Parameter]
    public bool focused { get; set; } = false;

    [Parameter]
    public EventCallback endpointsExplorerClicked { get; set; }
    [Parameter]
    public EventCallback<ApiEndpoint> endpointFocused { get; set; }
    [Parameter]
    public EventCallback<ApiEndpoint> endpointOpened { get; set; }
    [Parameter]
    public EventCallback<ApiEndpoint> endpointDeleted { get; set; }
    [Parameter]
    public EventCallback endpointCreated { get; set; }

    private string endpointsClass = "";
    private ApiEndpoint? focusedEndpoint = null; //the endpoint that should be displayed in the editor/props
    private ApiEndpoint? contexedEndpoint = null; //the endpoint the context menu is opened for
    private string contextMenuStyle = "display: none;";

    private DotNetObjectReference<EndpointsExplorer>? objRef;

    private ExplorerDisplayOption? foldersDisplayOption = null;
    private ExplorerDisplayOption? allDisplayOption = ExplorerDisplayOption.SORT_BY_CREATION_DATE;


    protected override async Task OnParametersSetAsync()
    {
        StateHasChanged();
        await Task.Yield();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            objRef = DotNetObjectReference.Create(this);
            await js.InvokeVoidAsync("setupClickEventListener", objRef, "KillContextMenu");
            await js.InvokeVoidAsync("gsapInterop.makeDraggable", "#project-endpoints-explorer");
        }
    }

    private async Task HandleExplorerClicked()
    {
        await endpointsExplorerClicked.InvokeAsync();
    }

    private async Task HandleEndpointSelected(ApiEndpoint endpoint)
    {
        await endpointFocused.InvokeAsync(endpoint);
    }
    private async Task HandleEndpointOpened(ApiEndpoint endpoint)
    {
        await endpointOpened.InvokeAsync(endpoint);
    }
    private async Task HandleEndpointRightClicked((ApiEndpoint endpoint, MouseEventArgs mea) p)
    {
        contexedEndpoint = p.endpoint;
        contextMenuStyle = $"display: flex; left: {p.mea.ClientX}px; top: {p.mea.ClientY}px;";
    }
    private async Task HandleEditContexed()
    {
        await endpointOpened.InvokeAsync(contexedEndpoint);
    }
    private async Task HandleDeleteContexed()
    {
        await endpointDeleted.InvokeAsync(contexedEndpoint);
    }


    /*SORTING ENDPOINTS AND FOLDERS*/
    private List<ApiEndpoint> SortEndpointsByName(List<ApiEndpoint> endpoints, bool reversed = false)
    {
        var sortedList = endpoints;
        if (!reversed)
        {
            sortedList.Sort((x, y) => x.name.CompareTo(y.name));
        } else
        {
            sortedList = sortedList.OrderByDescending(x => x.name).ToList();
        }
        return sortedList;
    }
    private List<ApiEndpoint> SortEndpointsByType(List<ApiEndpoint> endpoints, bool reversed = false)
    {
        var sortedList = endpoints;
        if (!reversed)
        {
            sortedList.Sort((x, y) => x.method.CompareTo(y.method));
        } else
        {
            sortedList = sortedList.OrderByDescending(x => x.method).ToList();
        }
        return sortedList;
    }
    private List<ApiEndpoint> SortEndpointsByCreationDate(List<ApiEndpoint> endpoints, bool reversed = false)
    {
        var sortedList = endpoints;
        if (!reversed)
        {
            sortedList = sortedList.OrderBy(x => x.created_at_utc).ToList();
        } else
        {
            sortedList = sortedList.OrderByDescending(x => x.created_at_utc).ToList();
        }
        return sortedList;
    }
    private List<ApiEndpoint> SortEndpointsByLastModifiedDate(List<ApiEndpoint> endpoints, bool reversed = false)
    {
        var sortedList = endpoints;
        if (!reversed)
        {
            sortedList = sortedList.OrderBy(x => x.last_updated_utc).ToList();
        } else
        {
            sortedList = sortedList.OrderByDescending(x => x.last_updated_utc).ToList();
        }
        return sortedList;
    }
    private List<ProjectFolder> SortFoldersByName(List<ProjectFolder> Folders, bool reversed = false)
    {
        var sortedList = Folders;
        if (!reversed)
        {
            sortedList.Sort((x, y) => x.name.CompareTo(y.name));
        }
        else
        {
            sortedList = sortedList.OrderByDescending(x => x.name).ToList();
        }
        return sortedList;
    }
    private List<ProjectFolder> SortFoldersByCreationDate(List<ProjectFolder> Folders, bool reversed = false)
    {
        var sortedList = Folders;
        if (!reversed)
        {
            sortedList = sortedList.OrderBy(x => x.created_at_utc).ToList();
        }
        else
        {
            sortedList = sortedList.OrderByDescending(x => x.created_at_utc).ToList();
        }
        return sortedList;
    }
    private List<ProjectFolder> SortFoldersByLastModifiedDate(List<ProjectFolder> Folders, bool reversed = false)
    {
        var sortedList = Folders;
        if (!reversed)
        {
            sortedList = sortedList.OrderBy(x => x.last_updated_utc).ToList();
        }
        else
        {
            sortedList = sortedList.OrderByDescending(x => x.last_updated_utc).ToList();
        }
        return sortedList;
    }
    private List<ProjectFolder> SortFoldersByEndpointCount(List<ProjectFolder> Folders, bool reversed = false)
    {
        var sortedList = Folders;
        if (!reversed)
        {
            sortedList = sortedList.OrderBy(x => x.endpoints.Count).ToList();
        }
        else
        {
            sortedList = sortedList.OrderByDescending(x => x.endpoints.Count).ToList();
        }
        return sortedList;
    }
    /*END OF ENDPOINTS AND FOLDERS SORTING*/



    [JSInvokable]
    public void KillContextMenu()
    {
        contexedEndpoint = null;
        contextMenuStyle = "display: none;";
        Console.WriteLine("KillContextMenu");
        StateHasChanged();
    }

    public void Dispose() => objRef?.Dispose();
}
